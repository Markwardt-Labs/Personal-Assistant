<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Markwardt.PersonalAssistant.Client"
             x:Class="Markwardt.PersonalAssistant.Client.ReactionView"
             x:CompileBindings="False">
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Command="{Binding LikeCommand}" Classes="react" Classes.on="{Binding IsLiked}" AutomationProperties.Name="Like">
      <PathIcon Data="{StaticResource IconLike}" />
    </Button>
    <Button Command="{Binding DislikeCommand}" Classes="react" Classes.on="{Binding IsDisliked}" AutomationProperties.Name="Dislike">
      <PathIcon Data="{StaticResource IconDislike}" />
    </Button>
  </StackPanel>
</UserControl>
