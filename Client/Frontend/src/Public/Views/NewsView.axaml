<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Markwardt.PersonalAssistant.Client"
             x:Class="Markwardt.PersonalAssistant.Client.NewsView"
             x:CompileBindings="False">
  <Grid>
    <ScrollViewer>
      <StackPanel Margin="12,8">
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" Margin="0,0,0,6" />
        <TextBlock Text="{Binding SearchError}" IsVisible="{Binding HasSearchError}" Classes="error" Margin="0,0,0,6" />
        <TextBlock Text="No feeds yet. Tap the feeds icon to add one." IsVisible="{Binding NeedsFeeds}" Classes="muted" />
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:NewsFeedSectionViewModel">
              <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Name}" Classes="heading" FontSize="14" Margin="2,6,0,6" />
                <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Classes="muted body" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:NewsItemViewModel">
                      <local:NewsItemCardView />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Panel IsVisible="{Binding IsManagingFeeds}">
      <local:NewsFeedsView />
    </Panel>
  </Grid>
</UserControl>
