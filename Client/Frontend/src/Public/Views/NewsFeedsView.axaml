<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Markwardt.PersonalAssistant.Client"
             x:Class="Markwardt.PersonalAssistant.Client.NewsFeedsView"
             x:CompileBindings="False">
  <Border Classes="overlay">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" Classes="bar">
        <Grid ColumnDefinitions="Auto,*">
          <Button Grid.Column="0" Command="{Binding CloseFeedsCommand}" Classes="icon" AutomationProperties.Name="Back">
            <PathIcon Data="{StaticResource IconBack}" />
          </Button>
          <TextBlock Grid.Column="1" Text="News Feeds" Classes="barTitle" Margin="4,0" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Sections}" Margin="12,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:NewsFeedSectionViewModel">
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="1" Margin="0,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Classes="entryTitle" />
                    <TextBlock Text="{Binding Description}" Classes="meta" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Command="{Binding RemoveCommand}" Classes="icon" AutomationProperties.Name="Remove">
                    <PathIcon Data="{StaticResource IconDelete}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBox Text="{Binding NewName}" PlaceholderText="Name" />
              <TextBox Text="{Binding NewDescription}" PlaceholderText="What to search for, such as new AI models and chips" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding AddFeedCommand}" Classes="icon primary" VerticalAlignment="Bottom" AutomationProperties.Name="Add Feed">
              <PathIcon Data="{StaticResource IconAdd}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
